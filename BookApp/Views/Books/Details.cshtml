@model BookDetails
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="mb-1">@Model.Title</h1>
        <p class="text-muted mb-0">@Model.Author</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Править</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Удалить книгу?');">
            <button class="btn btn-outline-danger" type="submit">Удалить</button>
        </form>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Год издания</dt>
    <dd class="col-sm-9">@(Model.PublishedYear?.ToString() ?? "—")</dd>
    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@(Model.Isbn ?? "—")</dd>
    <dt class="col-sm-3">Издательство</dt>
    <dd class="col-sm-9">@(Model.Publisher ?? "—")</dd>
    <dt class="col-sm-3">Жанр</dt>
    <dd class="col-sm-9">@(Model.Genre ?? "—")</dd>
    <dt class="col-sm-3">Язык</dt>
    <dd class="col-sm-9">@(Model.Language ?? "—")</dd>
    <dt class="col-sm-3">Страниц</dt>
    <dd class="col-sm-9">@(Model.PageCount?.ToString() ?? "—")</dd>
    <dt class="col-sm-3">Аннотация</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
</dl>

<h2>Оглавление</h2>
@if (string.IsNullOrWhiteSpace(Model.ContentsHtml))
{
    <p class="text-muted">Оглавление не заполнено.</p>
}
else
{
    <div class="border rounded p-3">
        @Html.Raw(Model.ContentsHtml)
    </div>
}

<p class="mt-4"><a asp-action="Index">К списку</a></p>
